{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "etzhayyim-agentgateway",
  "main": "svelte/.svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2024-12-20",
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message",
      "zone_name": "etzhayyim.com"
    }
  ],
  "assets": {
    "directory": "./svelte/.svelte-kit/cloudflare/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "vars": {
    "APP_FRAMEWORK": "sveltekit-edge-bff",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message"
  }
}
