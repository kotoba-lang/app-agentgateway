  "@type": "Project",
  "name": "AI Agent Gateway (etzhayyim-project-agentgateway)",
  "status": "In Progress",
  "identifier": "etzhayyim-project-agentgateway",
  "description": "Application-level MCP (Model Context Protocol) Router built on AT Protocol. Serves as the central entry point for AI Agents to discover and call tools across the Etzhayyim ecosystem.",
  "etzhayyim:vision": "Provide a unified, highly-available MCP routing layer that connects AI Agents to downstream tools and services without exposing internal network topologies.",
  "hasPart": [],
  "tasks": [
    {
      "status": "in_progress",
      "id": "task-1",
      "content": "Initialize project structure (Cloudflare Worker)."
    },
    {
      "status": "pending",
      "id": "task-2",
      "content": "Implement AT Protocol / XRPC `com.etzhayyim.mcp.message` handler."
    },
    {
      "status": "pending",
      "id": "task-3",
      "content": "Implement tool discovery and routing logic."
    }
  ],
  "etzhayyim:architecture": {
    "runtime": "Cloudflare Worker",
    "protocol": "AT Protocol (XRPC), JSON-RPC 2.0 (MCP)",
    "entrypoint": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message (or dedicated subdomain)"
  }
}
